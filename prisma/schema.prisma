generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  apiUrl    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
}

model Vehicle {
  id                 String                   @id @default(cuid())
  vehicleName        String
  vehicleNumber      String
  gpsDeviceId        String
  driverName         String
  clientId           String
  status             VehicleStatus            @default(IDLE)
  latitude           Float                    @default(0)
  longitude          Float                    @default(0)
  speed              Float                    @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  batteryVoltage     Float?                   @default(0)
  charge             Boolean                  @default(false)
  ignition           Boolean                  @default(false)
  isOnline           Boolean                  @default(true)
  lastProviderUpdate DateTime?
  lastSeenAt         DateTime?
  providerName       String?
  providerVehicleId  String?
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationHistory    VehicleLocationHistory[]

  @@unique([clientId, vehicleNumber])
}

model VehicleLocationHistory {
  id        String   @id @default(cuid())
  vehicleId String
  latitude  Float
  longitude Float
  speed     Float
  ignition  Boolean
  heading   Float    @default(0)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  VIEWER
}

enum VehicleStatus {
  MOVING
  IDLE
  OFFLINE
}
