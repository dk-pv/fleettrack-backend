generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  apiUrl    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
  trips     Trip[]
  customers Customer[]
}

model Vehicle {
  id                 String                   @id @default(cuid())
  vehicleName        String
  vehicleNumber      String
  gpsDeviceId        String
  driverName         String
  clientId           String
  status             VehicleStatus            @default(IDLE)
  latitude           Float                    @default(0)
  longitude          Float                    @default(0)
  speed              Float                    @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  batteryVoltage     Float?                   @default(0)
  charge             Boolean                  @default(false)
  ignition           Boolean                  @default(false)
  isOnline           Boolean                  @default(true)
  lastProviderUpdate DateTime?
  lastSeenAt         DateTime?
  providerName       String?
  providerVehicleId  String?
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationHistory    VehicleLocationHistory[]
  trips              Trip[]

  @@unique([clientId, vehicleNumber])
}

model VehicleLocationHistory {
  id        String   @id @default(cuid())
  vehicleId String
  latitude  Float
  longitude Float
  speed     Float
  ignition  Boolean
  heading   Float    @default(0)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  VIEWER
}

enum VehicleStatus {
  MOVING
  IDLE
  OFFLINE
}

enum TripStatus {
  PLANNED
  ASSIGNED
  STARTED
  ONGOING
  DELAYED
  COMPLETED
  CANCELLED
}

enum TripEventAction {
  CREATED
  UPDATED
  STATUS_CHANGED
}

model Trip {
  id             String     @id @default(cuid())
  reference      String
  status         TripStatus @default(PLANNED)

  // Owner (the client that manages the trip)
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Assignment (nullable until assigned)
  vehicleId      String?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId       String?
  driverName     String?

  // Customer this trip is for (CUS-07) — nullable; detaches on customer delete
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Route (coords optional — geocoded on create)
  origin         String
  originLat      Float?
  originLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?

  distanceKm     Float      @default(0)
  durationMins   Int        @default(0)
  notes          String?

  scheduledStart DateTime
  scheduledEnd   DateTime
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  stops          TripStop[]
  events         TripEvent[]
  breadcrumbs    TripBreadcrumb[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([customerId])
}

model TripStop {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  address  String
  sequence Int
  lat      Float?
  lng      Float?

  @@index([tripId])
}

model TripEvent {
  id        String          @id @default(cuid())
  tripId    String
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  action    TripEventAction
  status    TripStatus?
  note      String?
  actorRole String
  actorName String?
  createdAt DateTime        @default(now())

  @@index([tripId])
}

// GPS breadcrumb recorded server-side from the vehicle feed while a trip is active,
// so a completed trip can replay its actual travelled route (mirrors
// VehicleLocationHistory but scoped to a trip).
model TripBreadcrumb {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  speed     Float    @default(0)
  heading   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([createdAt])
}

// Customer directory (shipper / receiver / corporate) — tenant-owned data: each
// customer belongs to the CLIENT that manages it (CUS-01/02). A CLIENT sees and
// manages only its own customers; the ADMIN does not manage customers.
enum CustomerType {
  SHIPPER
  RECEIVER
  CORPORATE
}

model Customer {
  id                 String       @id @default(cuid())
  name               String
  type               CustomerType

  // Owning client (tenant) — a CLIENT manages only its own customers
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Contact information (CUS-03.1)
  company            String?
  contactPerson      String?
  email              String?
  phone              String?
  address            String?

  // Tax / registration details (CUS-04.1)
  taxId              String?
  registrationNumber String?

  // Free-text notes (CUS-08.1)
  notes              String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Reusable pickup/delivery address book (CUS-05 / CUS-06)
  addresses          CustomerAddress[]

  // Trips placed for this customer (CUS-07)
  trips              Trip[]

  @@index([clientId])
  @@index([type])
}

// A reusable pickup or delivery address for a customer (CUS-05 / CUS-06).
// isDefault flags the preferred address per kind for future trip auto-selection.
enum AddressKind {
  PICKUP
  DELIVERY
}

model CustomerAddress {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       AddressKind
  label      String
  address    String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@index([customerId, kind])
}
